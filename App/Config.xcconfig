// Public build config — committed. Real secrets go in App/Secrets.xcconfig
// (gitignored), which this file optionally includes to override the blank
// anon key below. The Supabase URL is built in code as https://<host> to
// dodge the xcconfig "//" comment gotcha.

SUPABASE_HOST = uaxfteluwctrlgwmmfzi.supabase.co
SUPABASE_ANON_KEY =

// Realtime voice proxy (CF Worker -> DashScope Qwen-Omni). The HOST only: an
// xcconfig value is truncated at "//", so the wss:// scheme is added in code
// (same dodge as SUPABASE_HOST). Public endpoint — the worker authenticates
// each connection with the user's Supabase token, so this is not a secret.
// voiceConfigured() gates the Talk button on it being set; it was blank in
// every shipped build, so Talk never worked on iOS (found 2026-09-09).
VOICE_PROXY_HOST = unstuck-voice-proxy.justtesting6363.workers.dev

#include? "Secrets.xcconfig"
